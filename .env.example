MONGO_USER=nexusync
MONGO_PASSWORD=troque-por-uma-senha-forte
ADMIN_PASSWORD=troque-pela-senha-do-painel
# Opcional: segredo para assinar a sessão do painel (padrão: ADMIN_PASSWORD)
AUTH_SECRET=ADMIN_PASSWORD
# "true" quando servido por HTTPS; use "false" para testar em http://localhost
COOKIE_SECURE=true

# Só para rodar fora do Docker (npm run dev)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=nexusync
