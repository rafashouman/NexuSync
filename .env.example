MONGO_USER=nexusync
MONGO_PASSWORD=troque-por-uma-senha-forte
ADMIN_PASSWORD=troque-pela-senha-do-painel
AUTH_SECRET=ADMIN_PASSWORD
# "true" quando servido por HTTPS; use "false" para testar em http://localhost
COOKIE_SECURE=true
# Dog & Açaí: WhatsApp com DDI e DDD. Vazio exibe a prévia de demonstração.
NEXT_PUBLIC_DOG_ACAI_WHATSAPP=

# Google Analytics 4 (ID da métrica no formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S1X5J5VQXK

# Pixel padrão da NexuSync. O fallback atual é mantido se estiver vazio.
NEXT_PUBLIC_META_PIXEL_ID=1587285682708459
# Opcional: Pixel do cliente, usado somente em /templates/cyber-oregon.
# Sem este ID, a página continua sendo medida pelo Pixel padrão da agência.
NEXT_PUBLIC_CYBEROREGON_META_PIXEL_ID=
# API de Conversões (segredo, só no servidor): Gerenciador de Eventos > Pixel >
# Configurações > API de Conversões > Gerar token de acesso.
META_CAPI_ACCESS_TOKEN=
# Código de "Eventos de teste". Preencha só para testar e apague depois.
META_CAPI_TEST_EVENT_CODE=

# SMTP Hostinger para envio de e-mails do formulário CyberOregon
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=contato@seudominio.com.br
HOSTINGER_SMTP_PASS=sua-senha-do-email-hostinger
CYBEROREGON_NOTIFY_EMAIL=seu-email-de-destino@seudominio.com.br

# Destino dos pedidos de orçamento da NexuSync (SMTP acima)
NEXUSYNC_NOTIFY_EMAIL=contato@nexusync.online
